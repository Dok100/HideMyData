{
  "patterns": [
    {
      "id": "email",
      "description": "E-Mail-Adresse",
      "category": "private_email",
      "regex": "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b"
    },
    {
      "id": "phone_international",
      "description": "Internationale Telefonnummer mit Plus-Präfix",
      "category": "private_phone",
      "regex": "\\+(?:[0-9][\\s\\-.()]*){7,15}"
    },
    {
      "id": "iban",
      "description": "IBAN, auch mit optionalen Leerzeichen",
      "category": "account_number",
      "regex": "\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]){10,30}\\b(?!\\s*BIC\\b)"
    },
    {
      "id": "bic_labeled",
      "description": "BIC-Wert nach einem BIC-Label",
      "category": "account_number",
      "regex": "(?<=\\bBIC:\\s)[A-Z0-9]{8}(?:[A-Z0-9]{3})?\\b"
    },
    {
      "id": "kundennummer_labeled",
      "description": "Kundennummer nach dem Label Kundennummer",
      "category": "account_number",
      "regex": "(?:(?<=\\bKundennummer:\\s)|(?<=\\bKundennummer\\s))(?:[A-Z0-9][A-Z0-9\\-]{5,}|\\d{2,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "vertragsnummer_labeled",
      "description": "Vertragsnummer nach dem Label Vertragsnummer",
      "category": "account_number",
      "regex": "(?:(?<=\\bVertragsnummer:\\s)|(?<=\\bVertragsnummer\\s))[A-Z0-9][A-Z0-9\\-]{5,}\\b"
    },
    {
      "id": "zaehlernummer_labeled",
      "description": "Zählernummer nach dem Label Zählernummer oder Zaehlernummer",
      "category": "account_number",
      "regex": "(?<=\\b(?:Zählernummer|Zaehlernummer):\\s)\\d{6,}\\b"
    },
    {
      "id": "vorgangsnummer_labeled",
      "description": "Vorgangsnummer nach dem Label Vorgangsnummer",
      "category": "account_number",
      "regex": "(?:(?<=\\bVorgangsnummer:\\s)|(?<=\\bVorgangsnummer\\s))\\d{6,}\\b"
    },
    {
      "id": "telefon_labeled",
      "description": "Telefonnummer nach Telefon- oder Tel-Label",
      "category": "private_phone",
      "regex": "(?im)(?:(?<=\\bTelefon:\\s)|(?<=\\bTelefon\\s)|(?<=\\bTel\\.:\\s)|(?<=\\bTel\\.\\s))0\\d(?:[\\d\\s()./\\-]{5,}\\d)?\\b"
    },
    {
      "id": "mobil_labeled",
      "description": "Mobilnummer nach Mobil- oder Handy-Label",
      "category": "private_phone",
      "regex": "(?im)(?:(?<=\\bMobil:\\s)|(?<=\\bMobil\\s)|(?<=\\bHandy:\\s)|(?<=\\bHandy\\s))0\\d(?:[\\d\\s()./\\-]{5,}\\d)?\\b"
    },
    {
      "id": "konto_labeled",
      "description": "Kontowert nach dem Label Konto",
      "category": "account_number",
      "regex": "(?:(?<=\\bKonto:\\s)|(?<=\\bKonto\\s))(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "konto_field",
      "description": "Komplettes Kontofeld mit Label Konto",
      "category": "account_number",
      "regex": "\\bKonto\\s*:?\\s*(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "kontonummer_labeled",
      "description": "Kontonummer nach dem Label Kontonummer",
      "category": "account_number",
      "regex": "(?:(?<=\\bKontonummer:\\s)|(?<=\\bKontonummer\\s))(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "kontonummer_field",
      "description": "Komplettes Feld für Kontonummer",
      "category": "account_number",
      "regex": "\\bKontonummer\\s*:?\\s*(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "girokonto_labeled",
      "description": "Girokonto-Wert nach dem Label Girokonto",
      "category": "account_number",
      "regex": "(?:(?<=\\bGirokonto:\\s)|(?<=\\bGirokonto\\s))(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "girokonto_field",
      "description": "Komplettes Feld für Girokonto",
      "category": "account_number",
      "regex": "\\bGirokonto\\s*:?\\s*(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "girokontonummer_labeled",
      "description": "Girokontonummer nach dem gleichnamigen Label",
      "category": "account_number",
      "regex": "(?:(?<=\\bGirokontonummer:\\s)|(?<=\\bGirokontonummer\\s))(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "girokontonummer_field",
      "description": "Komplettes Feld für Girokontonummer",
      "category": "account_number",
      "regex": "\\bGirokontonummer\\s*:?\\s*(?:\\d{5,}|\\d{1,}(?:\\s\\d{2,})+)\\b"
    },
    {
      "id": "buchungskonto_labeled",
      "description": "Buchungskonto-Wert nach dem Label Buchungskonto",
      "category": "account_number",
      "regex": "(?:(?<=\\bBuchungskonto:\\s)|(?<=\\bBuchungskonto\\s))(?:\\d{2,}(?:\\s\\d{2,})+|[A-Z0-9][A-Z0-9\\- ]{5,})\\b"
    },
    {
      "id": "blz_labeled",
      "description": "BLZ-Wert nach dem Label BLZ",
      "category": "account_number",
      "regex": "(?<=\\bBLZ\\s)\\d{8}\\b"
    },
    {
      "id": "credit_card_16",
      "description": "16-stellige Kreditkartennummer mit optionalen Trennern",
      "category": "account_number",
      "regex": "\\b\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}\\b"
    },
    {
      "id": "credit_card_amex",
      "description": "15-stellige American-Express-Kreditkarte",
      "category": "account_number",
      "regex": "\\b3[47]\\d{2}[\\s\\-]?\\d{6}[\\s\\-]?\\d{5}\\b"
    },
    {
      "id": "credit_card_labeled",
      "description": "Kreditkartennummer nach einem expliziten Karten-Label",
      "category": "account_number",
      "regex": "(?i)\\b(?:Kreditkarten(?:nummer|nr\\.?|num(?:mer)?)|Kartennummer|Kartennr\\.?|Karten(?:nr\\.?|nummer)|Credit\\s*Card\\s*Number|Card\\s*Number|Kreditkarte)[:\\s-]+(?:[\\d*][\\s\\-*]?){12,22}[\\d*]\\b"
    },
    {
      "id": "german_honorific_name_slash",
      "description": "Deutscher Name mit Anrede im Format Nachname/Vorname",
      "category": "private_person",
      "regex": "(?i)\\b(?:Frau|Herr)\\s+[A-ZÄÖÜ][A-Za-zÄÖÜäöüß\\-]+/[A-ZÄÖÜ][A-Za-zÄÖÜäöüß\\-]+\\b"
    },
    {
      "id": "ipv4",
      "description": "IPv4-Adresse mit oktettgenauer Begrenzung",
      "category": "secret",
      "regex": "\\b(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)(?:\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)){3}\\b"
    },
    {
      "id": "mrz",
      "description": "Maschinenlesbare Passzone mit Großbuchstaben, Ziffern und Kleiner-als-Zeichen",
      "category": "secret",
      "regex": "\\b(?=[A-Z0-9<]{15,}\\b)(?=[A-Z0-9<]*[0-9<])[A-Z0-9<]{15,}\\b"
    },
    {
      "id": "polish_zip",
      "description": "Polnische Postleitzahl im Format NN-NNN",
      "category": "private_address",
      "regex": "\\b\\d{2}-\\d{3}\\b"
    },
    {
      "id": "german_postal_city",
      "description": "Deutsche PLZ-Stadt-Kombination mit bis zu drei Ortswörtern",
      "category": "private_address",
      "regex": "(?i)\\b\\d{5}[ \\t]*(?:\\n[ \\t]*)?(?!(?:Amazon|Bestell|Rechnung|Deutschland|Kontakt|Fax|Geschäftsführer|Registergericht|Kunden|Menge|Lieferung|Lieferadresse|Seite|Steuer(?:-Nr)?|Vorsitzender|Datum|Ersetzt)\\b)[A-ZÄÖÜa-zäöüß][A-Za-zÄÖÜäöüß.]+(?:[ -][A-Za-zÄÖÜäöüß.]+){0,2}\\b(?!<)"
    },
    {
      "id": "german_honorific_name",
      "description": "Deutscher Personenname mit Anrede",
      "category": "private_person",
      "regex": "(?i)\\b(?:Frau|Herr)\\s+[A-ZÄÖÜ][A-Za-zÄÖÜäöüß\\-]+(?:\\s+[A-ZÄÖÜ][A-Za-zÄÖÜäöüß\\-]+){1,2}\\b"
    },
    {
      "id": "german_couple_name_shared_surname",
      "description": "Zwei Personennamen mit gemeinsamem Nachnamen und 'und'",
      "category": "private_person",
      "regex": "\\b[A-ZÄÖÜ][A-Za-zÄÖÜäöüß\\-]+\\s+und\\s+[A-ZÄÖÜ][A-Za-zÄÖÜäöüß\\-]+\\s+[A-ZÄÖÜ][A-Za-zÄÖÜäöüß\\-]+\\b"
    },
    {
      "id": "german_street_house_number",
      "description": "Deutsche Straßenadresse mit Hausnummer",
      "category": "private_address",
      "regex": "(?i)\\b(?:[A-ZÄÖÜa-zäöüß][A-Za-zÄÖÜäöüß.\\-]*\\s+){0,3}[A-ZÄÖÜa-zäöüß][A-Za-zÄÖÜäöüß.\\-]*(?:straße|str\\.|strasse|weg|allee|platz|gasse|ring|ufer|steig|steige)\\s*\\d+[A-Za-z]?\\b"
    },
    {
      "id": "date_eu_dotted",
      "description": "Europäisches Datum mit Punkten, Kommas oder Schrägstrichen",
      "category": "private_date",
      "regex": "[\"'`´’‚]?(?:0?[1-9]|[12]\\d|3[01])\\s*[\\.,/]\\s*(?:0?[1-9]|1[0-2])\\s*[\\.,/]\\s*(?:18|19|20)?\\d{2}\\b"
    },
    {
      "id": "polish_nrb",
      "description": "Polnisches NRB-Konto mit 26 Ziffern und optionalen Trennern",
      "category": "account_number",
      "regex": "\\b\\d{2}(?:[\\s\\-]?\\d{4}){6}\\b"
    },
    {
      "id": "polish_street",
      "description": "Polnische Straßenadresse mit ul./al./pl./os.-Präfix",
      "category": "private_address",
      "regex": "\\b(?:ul|al|pl|os)\\.\\s+[^\\d]{1,80}\\d+[A-Za-z]?(?:\\s*/\\s*\\d+)?(?:\\s+m\\s*\\.?\\s*\\d+)?"
    },
    {
      "id": "polish_id_card",
      "description": "Polnische Ausweisnummer mit drei Buchstaben und sechs Ziffern",
      "category": "secret",
      "regex": "\\b[A-Z]{3}\\s+(?:nr\\s+)?\\d{6}\\b"
    },
    {
      "id": "polish_nip",
      "description": "Polnische Steuer-ID nach dem Label NIP",
      "category": "secret",
      "regex": "(?i)\\bNIP[:.\\s\\-]+(?:\\d[\\s\\-]?){9}\\d\\b"
    },
    {
      "id": "polish_krs",
      "description": "Polnische KRS-Nummer nach dem Label KRS",
      "category": "secret",
      "regex": "(?i)\\bKRS[:.\\s\\-]+\\d{10}\\b"
    },
    {
      "id": "polish_pesel",
      "description": "Polnische PESEL nach dem Label PESEL",
      "category": "secret",
      "regex": "(?i)\\bPESEL[:.\\s\\-]+\\d{11}\\b"
    },
    {
      "id": "us_ssn",
      "description": "US-Sozialversicherungsnummer im Format XXX-XX-XXXX",
      "category": "secret",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b"
    },
    {
      "id": "mac_address",
      "description": "MAC-Adresse mit Doppelpunkt oder Bindestrich",
      "category": "secret",
      "regex": "\\b(?:[0-9A-Fa-f]{2}[:\\-]){5}[0-9A-Fa-f]{2}\\b"
    },
    {
      "id": "ipv6",
      "description": "IPv6-Adresse in unkomprimierter oder teilweise komprimierter Form",
      "category": "secret",
      "regex": "\\b(?:[A-Fa-f0-9]{1,4}:){2,7}[A-Fa-f0-9]{1,4}\\b"
    },
    {
      "id": "uk_nino",
      "description": "Britische National-Insurance-Nummer",
      "category": "secret",
      "regex": "\\b[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z]\\s?\\d{2}\\s?\\d{2}\\s?\\d{2}\\s?[A-D]\\b"
    },
    {
      "id": "jwt",
      "description": "JSON Web Token mit drei Base64url-Segmenten",
      "category": "secret",
      "regex": "\\beyJ[\\w\\-]+\\.[\\w\\-]+\\.[\\w\\-]+\\b"
    },
    {
      "id": "aws_access_key",
      "description": "AWS-Access-Key mit AKIA-Präfix",
      "category": "secret",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b"
    },
    {
      "id": "github_token",
      "description": "GitHub-Token mit ghp_/gho_/ghs_/ghu_-Präfix",
      "category": "secret",
      "regex": "\\bgh[opsu]_[A-Za-z0-9]{36,}\\b"
    },
    {
      "id": "stripe_live_key",
      "description": "Stripe-Live-Secret-Key mit sk_live_-Präfix",
      "category": "secret",
      "regex": "\\bsk_live_[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "crypto_eth",
      "description": "Ethereum- oder EVM-Adresse mit 0x und 40 Hex-Zeichen",
      "category": "account_number",
      "regex": "\\b0x[a-fA-F0-9]{40}\\b"
    },
    {
      "id": "crypto_btc",
      "description": "Bitcoin-Adresse als Legacy- oder Bech32-Format",
      "category": "account_number",
      "regex": "\\b(?:bc1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{39,59}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\\b"
    },
    {
      "id": "crypto_dash",
      "description": "Dash-Adresse mit X-Präfix",
      "category": "account_number",
      "regex": "\\bX[1-9A-HJ-NP-Za-km-z]{33}\\b"
    },
    {
      "id": "crypto_xmr",
      "description": "Monero-Adresse mit 4- oder 8-Präfix",
      "category": "account_number",
      "regex": "\\b[48][1-9A-HJ-NP-Za-km-z]{94}\\b"
    },
    {
      "id": "crypto_xrp",
      "description": "Ripple- oder XRP-Adresse mit r-Präfix",
      "category": "account_number",
      "regex": "\\br[0-9a-zA-Z]{24,34}\\b"
    },
    {
      "id": "crypto_ltc",
      "description": "Litecoin-Adresse als Legacy- oder Bech32-Format",
      "category": "account_number",
      "regex": "\\b(?:ltc1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{39,59}|[LM][a-km-zA-HJ-NP-Z1-9]{26,34})\\b"
    },
    {
      "id": "crypto_bch",
      "description": "Bitcoin-Cash-Adresse mit bitcoincash:-Präfix",
      "category": "account_number",
      "regex": "\\bbitcoincash:q[a-z0-9]{41}\\b"
    },
    {
      "id": "crypto_doge",
      "description": "Dogecoin-Adresse mit D-Präfix",
      "category": "account_number",
      "regex": "\\bD[5-9A-HJ-NP-U][1-9A-HJ-NP-Za-km-z]{32}\\b"
    },
    {
      "id": "crypto_trx",
      "description": "Tron-Adresse mit T-Präfix",
      "category": "account_number",
      "regex": "\\bT[1-9A-HJ-NP-Za-km-z]{33}\\b"
    },
    {
      "id": "crypto_ada",
      "description": "Cardano-Adresse in addr1-, stake1-, Ae2- oder DdzFF-Form",
      "category": "account_number",
      "regex": "\\b(?:addr1[a-z0-9]{53,}|stake1[a-z0-9]{50,}|Ae2[1-9A-HJ-NP-Za-km-z]{50,}|DdzFF[1-9A-HJ-NP-Za-km-z]{50,})\\b"
    },
    {
      "id": "crypto_ton",
      "description": "TON-Adresse als Raw- oder userfreundliches EQ/UQ-Format",
      "category": "account_number",
      "regex": "\\b(?:0:[a-f0-9]{64}|[EU]Q[a-zA-Z0-9_\\-]{46})\\b"
    },
    {
      "id": "crypto_labeled",
      "description": "Krypto-Adress-Fallback nach einem Ticker-Label",
      "category": "account_number",
      "regex": "(?i)(?:Digital\\s+Currency\\s+Address:?\\s*)?\\b(?:ETH|BTC|XBT|BNB|USDT|USDC|TRX|SOL|XRP|LTC|DASH|XMR|BCH|DOGE|ADA|TON)[:\\s]+[A-Za-z0-9]{26,}\\b"
    }
  ]
}
